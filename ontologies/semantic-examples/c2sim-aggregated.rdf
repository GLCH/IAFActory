    </rdfs:subPropertyOf>
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#UUIDBase"/>
    <rdfs:comment>A unique identifier in UUID format.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/lox#hasPlanPhaseReference">
