        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasDISKind"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#byte"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nc88854a8f2b64c479986baeba29aa3e7">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasDISSpecific"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#byte"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nf0b3822ebf3c42c79d3fb38e9a119f6c">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasDISSubCategory"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#byte"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>Simulation Entity Type as specified by SISO-REF-010-2016, Reference for Enumerations for Simulation Interoperability, version 27 (2019). 
Used to define the type of an Entity for its representation and modeling in simulations.</rdfs:comment>
  </owl:Class>
