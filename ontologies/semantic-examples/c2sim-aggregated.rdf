        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="http://www.sisostds.org/ontologies/smx#MIPRequestCategoryCode"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>A request whose category is defined by the JC3IEDM request category code.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/lox#PlanBody">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#DomainMessageBody"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N810d97b442444d5c8af4fd030fb142dc">
