      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>This is a collection class that may be used for different types of messages reporting information to other systems.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasTimeReferenceCode">
