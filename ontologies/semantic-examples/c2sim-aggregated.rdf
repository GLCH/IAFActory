      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N3fbb3c9f6efc43ab8c26336658857226">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasEntityDescriptor"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="http://www.sisostds.org/ontologies/C2SIM#EntityDescriptor"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N8a255996db8e4e3f9173293338586bc5">
