        <owl:onDataRange rdf:resource="http://www.sisostds.org/ontologies/C2SIM#UUIDBase"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>This is a relationship of friendly, hostile, or neutral toward an actor entity. It is part of the definition of the hasAllegianceTo property of an EntityDescriptor.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#SpatialOffset">
