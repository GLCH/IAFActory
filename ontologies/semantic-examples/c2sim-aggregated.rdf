        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
      </owl:Restriction>
    </owl:annotatedTarget>
    <rdfs:comment>This is the probabilty that the reported value is correct.
A value between 0 and 1.</rdfs:comment>
  </owl:Axiom>
