  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasEntityReference">
    <rdfs:subPropertyOf>
      <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasReference">
        <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#UUIDBase"/>
        <rdfs:comment>Instances of the class have reference to instanced of another associated class.</rdfs:comment>
      </owl:DatatypeProperty>
    </rdfs:subPropertyOf>
    <rdfs:range>
      <rdfs:Datatype rdf:about="http://www.sisostds.org/ontologies/C2SIM#UUIDBase">
        <owl:equivalentClass>
          <rdfs:Datatype rdf:nodeID="N9441908048584cd8a64fe62ce071b024">
            <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            <owl:withRestrictions rdf:parseType="Collection">
              <rdf:Description rdf:nodeID="Ncf99eda424984e348750f0e351c4eed0">
                <xsd:pattern>[0-9a-fA-F]{8}\-[0-9a-fA-F]{4}\-[0-9a-fA-F]{4}\-[0-9a-fA-F]{4}\-[0-9a-fA-F]{12}</xsd:pattern>
              </rdf:Description>
            </owl:withRestrictions>
          </rdfs:Datatype>
        </owl:equivalentClass>
      </rdfs:Datatype>
    </rdfs:range>
    <rdfs:comment>The reference is to an instance of an Entity.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#AcknowledgeTypeCode">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#MessageCode"/>
    <rdfs:comment>Enumeration of different types of acknowledgements.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasSubordinate">
    <rdfs:subPropertyOf>
      <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasActorReference">
