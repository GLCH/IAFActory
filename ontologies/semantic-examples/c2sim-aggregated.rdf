        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasReportContent"/>
        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
        <owl:onClass rdf:resource="http://www.sisostds.org/ontologies/C2SIM#ReportContent"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N35df66674f3b40d0b547572ea0d1e92f">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasReportID"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.sisostds.org/ontologies/C2SIM#UUIDBase"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nb13990b84f354f06ac48d28f9fbd257d">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasReportingEntity"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.sisostds.org/ontologies/C2SIM#UUIDBase"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>The structure for sending report messages.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasSubjectEntity">
    <rdfs:subPropertyOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasActorReference"/>
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#UUIDBase"/>
    <rdfs:comment>The reference is to an instance of SubjectEntity.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasDISCountry">
    <rdfs:subPropertyOf>
      <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasDISCode">
        <rdfs:comment>Provides an entity type code from IEEE 1516-2010 Distributed Interactive Simulation.</rdfs:comment>
      </owl:DatatypeProperty>
    </rdfs:subPropertyOf>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment>Provides a Country Code from the DIS standard IEEE 1516-2010.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#SecurityClassificationCode">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#Code"/>
    <rdfs:comment>Alphabetic text descriptions used by the USA-Department of Defense to identify the level of sensitivity of information</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/smx#Observation">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#C2SIMContent"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nb6d5ad424047436ebf36f5669b22b3a5">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasActorReference"/>
        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N087ca81b81dc46f68eebed92709a2ef4">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/smx#hasConfidenceLevel"/>
        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nb7290ba5fa8f416ab943593895ced7ec">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/smx#hasUncertaintyInterval"/>
        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>This is an observation of the state of something in the world; generally an actor, but possibly anything that is an entity. Subclasses define specific observations that can be made.
The subclasses defined here are sufficient to create a report with Size, Activity, Location, Unit Identification, Time, and Equipment, or some subset of that.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasConversationID">
    <rdfs:subPropertyOf>
      <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasMessagingDataProperty">
        <rdfs:comment>These are properties of classes associated with C2SIM Messages.</rdfs:comment>
      </owl:DatatypeProperty>
    </rdfs:subPropertyOf>
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#UUIDBase"/>
    <rdfs:comment>FIPA identifer unique to a particular thread of messages for a particular sender.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasIssuedTime">
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasDateTime">
        <rdfs:subPropertyOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasTimeInstant"/>
        <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#DateTime"/>
        <rdfs:comment>Provides a value for a Time Instant in ISO DateTime format</rdfs:comment>
      </owl:ObjectProperty>
    </rdfs:subPropertyOf>
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#DateTime"/>
    <rdfs:comment>Provides a value in ISO Date Time format for the time when an Order was issued.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasTimeOfObservation">
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasTimeInstant">
        <rdfs:subPropertyOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasTemporalConcept"/>
        <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#TimeInstant"/>
        <rdfs:comment>The object is referenced to a specific instant in time, specified in one of the ways that time can be represented--for example DateTime, Simulation Time, or Relative Time.</rdfs:comment>
      </owl:ObjectProperty>
    </rdfs:subPropertyOf>
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#TimeInstant"/>
    <rdfs:comment>provides a time at which a reported Observation was made</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#InitializationDataFile">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#InitializationConcept"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N83a0e69d75764dc99250ddb19c2230c0">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasName"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nfaf68f9bbb604b7e81cfe343dfa82f55">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasSystemName"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nd04f0a5dcb924ad19a4d89a967b426fc">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasIntializationFileType"/>
        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>Defines a file of supplementary data that is used to initialize the scenario. This file is generally system-specific, for example a terrain database file or a mapping from C2SIM entity types to local entity type enumerations. It could apply to "all" systems.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#EntityState">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#C2SIMContent"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N4917a14a9d3646c5955faec60be3d0fe">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasDateTime"/>
        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
        <owl:onClass rdf:resource="http://www.sisostds.org/ontologies/C2SIM#TimeInstant"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>Dynamic state information for entities in the exercise.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasReportingEntity">
    <rdfs:subPropertyOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasActorReference"/>
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#UUIDBase"/>
    <rdfs:comment>The reference is to an instance of ReportingEntity.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasName">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>An alphanumeric identifier that serves for humans to recognize the instance.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#Task">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#Action"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N91c85c6fa7d6485a8d511a296d0dc30f">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasDesiredEffectCode"/>
        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
        <owl:onClass rdf:resource="http://www.sisostds.org/ontologies/C2SIM#DesiredEffectCode"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N2515ec66ec9344f29891da86b3d07c64">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasTaskActionCode"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="http://www.sisostds.org/ontologies/C2SIM#TaskActionCode"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N7374503749b742a287449bf5e93b5d94">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasDuration"/>
        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
        <owl:onClass rdf:resource="http://www.sisostds.org/ontologies/C2SIM#Duration"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N98d6fcd3f5064dc29463e89034a49217">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasEndTime"/>
        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
        <owl:onClass rdf:resource="http://www.sisostds.org/ontologies/C2SIM#TimeInstant"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nd9247b0dda894e08ba0b15ba6fd7e199">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasStartTime"/>
        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
        <owl:onClass rdf:resource="http://www.sisostds.org/ontologies/C2SIM#TimeInstant"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N22141d837c2b499c947dcf3db1d9a506">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasAffectedEntity"/>
        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.sisostds.org/ontologies/C2SIM#UUIDBase"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N67778143783349a791ee4276077161c2">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasPerformingEntity"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.sisostds.org/ontologies/C2SIM#UUIDBase"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>A request for an actor in the domain to perform a Task. The actor to perform the Task is indicated by the hasPerformingEntity property of the Task.</rdfs:comment>
    <rdfs:comment>An Action that takes place over time, and is performed by an Entity to change the state of the world.
Must identify WHO, WHAT, WHEN and WHERE.
WHO is represented by hasPerformingEntity (and hasAffectedEntity).
WHAT is represented by the hasTaskActionCode.
WHEN is represented by the start time/duration/end time (2 of 3)
WHERE is represented by hasLocation and/or hasMapGraphicID reference.
WHY may be represented by hasDesiredEffect.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#ScenarioSetting">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#InitializationConcept"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N831b6f0a4af4443eb7548375f8667712">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasDateTime"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="http://www.sisostds.org/ontologies/C2SIM#DateTime"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N920bc2ab2063456b9d03aee40992684e">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasVersion"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>Information describing the setting of the scenario, including the date, time, physical extent of the terrain, and a version string.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#PlaybackStatusCode">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#MessageCode"/>
    <rdfs:comment>Enumeration of states of the playback of recorded messages.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#AuthorizationHeader">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#C2SIMContent"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N11ab8fb14ab542a09d4efc56961a6c1c">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasAuthorizationCredentials"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.sisostds.org/ontologies/C2SIM#angle"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N226839b9909147a59e293fddcffd6706">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasAuthorizationType"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.sisostds.org/ontologies/C2SIM#angle"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>The Authorization header is a part of the C2SIM headers used in client-server communications. Its primary function is to authenticate a user-agent with a server, typically by carrying credentials in the form of a token or a set of credentials like username and password. This header is fundamental in implementing security measures for web applications and APIs.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#EulerAngles">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#Orientation"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nb2cf4ac20c06467fbc17d2ca0ad9f485">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasPhi"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.sisostds.org/ontologies/C2SIM#angle"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nd9f25cc82e0f4122907b1abb83aa5ba0">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasPsi"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.sisostds.org/ontologies/C2SIM#angle"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N5b37667e59a34769950e8fc3bbe154be">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasTheta"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.sisostds.org/ontologies/C2SIM#angle"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>Representation of the orientation of an entity in 3D space expressed as Euler angles (DIS). This orientation will be used primarily for initialization of simulation entities, especially those that are not clamped to the ground.
This orienation indicates rotations from a geocentric coordinate system.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#RecordingStatusCode">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#MessageCode"/>
    <rdfs:comment>Enumeration of states of the recording of messages sent during execution of a C2SIM coalition of systems.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasActionTemporalAssociationCode">
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasCode">
        <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#Code"/>
        <rdfs:comment>Provides value of some Code associated with a class.</rdfs:comment>
      </owl:ObjectProperty>
    </rdfs:subPropertyOf>
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#ActionTemporalAssociationCode"/>
    <rdfs:comment>An enumerated list of specific temporal relationships, i.e. between two actions.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#RelativeTime">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#TimeInstant"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Naeb854cad79c424e93ffd9bf0c594900">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasDelayTimeAmount"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="http://www.sisostds.org/ontologies/C2SIM#Duration"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nc384b3ea7b544437b1fd4b3d8a81113f">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasTimeReferenceCode"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="http://www.sisostds.org/ontologies/C2SIM#TimeReferenceCode"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Na9fc9d4145da4dc1905205aea975cd37">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasEventReference"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.sisostds.org/ontologies/C2SIM#UUIDBase"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>Specifies an absolute time relative to the start or end time of an event.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/smx#hasAPP6C-SIDC">
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/smx#SymbolIDCodeString"/>
    <rdfs:comment>Provides a SIDC (Symbol Identification Code) string associated with the NATO APP-6-C Tactical Graphics symbol.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#isInReplyToMessageID">
    <rdfs:subPropertyOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasMessagingDataProperty"/>
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#UUIDBase"/>
    <rdfs:comment>Unique FIPA identifer of the message to be identified in a message reply.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasPsi">
    <rdfs:subPropertyOf>
      <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasAngle">
        <rdfs:subPropertyOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasSpatialMeasure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
      </owl:DatatypeProperty>
    </rdfs:subPropertyOf>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:comment>Property of geospatial data value that represents Euler Angle Psi in radians.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasPlaybackRealtimeMultiple">
    <rdfs:range>
      <rdfs:Datatype rdf:about="http://www.sisostds.org/ontologies/C2SIM#playbackRealtimeMultiple">
        <rdfs:comment>playbackRealtimeMultiple is a datatype for setting the simulation time to realtime multiplier for the rate of playing back recorded messages in a C2SIM coalition of systems. It is defined as a positive decimal type. For example, a value of 2.5 indicates playback of recorded messages at 2.5 times faster than realtime. A value of 0.5 indicates playback of recorded messages at half the realtime clock, or running half the speed of realtime.</rdfs:comment>
        <owl:equivalentClass>
          <rdfs:Datatype rdf:nodeID="N3b8ac421f619449da5e2c50e9dd0648e">
            <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            <owl:withRestrictions rdf:parseType="Collection">
              <rdf:Description rdf:nodeID="N209884247a184d2898e44d7479e8cf91">
                <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</xsd:minExclusive>
              </rdf:Description>
            </owl:withRestrictions>
          </rdfs:Datatype>
        </owl:equivalentClass>
      </rdfs:Datatype>
    </rdfs:range>
    <rdfs:comment>Decimal rate indicating ratio of simulation time to real time for playback of recorded messages (e.g., value of 2.0 indicates messages are played back at 2:1 simulation time to realtime [i.e., faster than realtime]; 0.5 indicates message playback at half realtime [i.e., slower than realtime]).</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasSecurityClassificationCode">
    <rdfs:subPropertyOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasCode"/>
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#SecurityClassificationCode"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#TaskStatus">
