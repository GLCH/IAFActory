      </owl:DatatypeProperty>
    </rdfs:subPropertyOf>
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#UUIDBase"/>
    <rdfs:comment>Indicates an AbstractOrganization that the entity is affiliated with in some way.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasSpatialOffset">
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#SpatialOffset"/>
