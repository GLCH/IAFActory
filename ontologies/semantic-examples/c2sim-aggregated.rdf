        <owl:onClass rdf:resource="http://www.sisostds.org/ontologies/C2SIM#TimeInstant"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N55485f0849d94408893cc83575900fdb">
