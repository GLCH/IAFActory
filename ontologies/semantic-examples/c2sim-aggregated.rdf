      <owl:Restriction rdf:nodeID="N84bba47bd0374136a317706bef1dacd3">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/smx#hasOtherSide"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.sisostds.org/ontologies/C2SIM#UUIDBase"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>This relation describes the hostility relationship of a military force toward another force. The force that has this relationship as its property is the "military force", while the force named in the hasOtherSide property of this relationship is "another force."</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/smx#hasCommandRelationCode">
    <rdfs:subPropertyOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasCode"/>
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/smx#CommandRelationCode"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasPhi">
    <rdfs:subPropertyOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasAngle"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:comment>Property of geospatial data value that represents Euler Angle Phi in radians.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasAbstractObject">
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#AbstractObject"/>
    <rdfs:comment>Reference to an AbstractObject class</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasStrengthPercentage">
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
    <rdfs:range>
      <rdfs:Datatype rdf:about="http://www.sisostds.org/ontologies/C2SIM#percentage">
        <owl:equivalentClass>
          <rdfs:Datatype rdf:nodeID="N372004911df54f92950df0fcc01a4ed0">
            <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
            <owl:withRestrictions rdf:parseType="Collection">
              <rdf:Description rdf:nodeID="Nc2e4cb3e2608472a9e6beb95857bcd0c">
                <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">100</xsd:maxInclusive>
              </rdf:Description>
            </owl:withRestrictions>
          </rdfs:Datatype>
        </owl:equivalentClass>
      </rdfs:Datatype>
    </rdfs:range>
    <rdfs:comment>The HealthStatus includes a value for Strength Percentage as a fraction of expected maximum numerical strength; vlue should be in range 0 to 100.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#PhysicalConcept">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#C2SIMContent"/>
    <rdfs:comment>Concepts relating to the physical characteristics of an entity (e.g., location, health, orientation, size, etc.). The subclasses of this class have complex or alternative representations, and so are classes. Other physical properties such as mass that are simple scalars can be data type properties of (ConcreteEntity) objects.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/lox#TaskFunctionalRelation">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#Relationship"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N04d23ddb94e74734a069cae5f3a37dc4">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/lox#hasTaskFunctionalAssociationCode"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="http://www.sisostds.org/ontologies/lox#TaskFunctionalAssociationCode"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N0ca7c07a33cb4fa281b8fd88ff703121">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/lox#hasFunctionalAssociationWithTask"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.sisostds.org/ontologies/C2SIM#UUIDBase"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>A functional relationship between maneuver warfare tasks.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#DesiredEffectCode">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#Code"/>
    <rdfs:comment>A code describing the intended effect of a task.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasTasker">
    <rdfs:subPropertyOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasActorReference"/>
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#UUIDBase"/>
    <rdfs:comment>Reference to the UUID of the entity ordering another entity to perform a task.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#InitializationConcept">
    <rdfs:comment>This parent class collects together classes that are necessary for the initialization of a scenario.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#Code">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#C2SIMContent"/>
    <rdfs:comment>A collection of enumerations used by various data types in C2SIM</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasAllegianceRelationshipCode">
    <rdfs:subPropertyOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasCode"/>
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#AllegianceRelationshipCode"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#TimeInstant">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#TemporalConcept"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nfdf2d4a86abb4415820f88cc727a580a">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasName"/>
        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>A specific time expressed in seconds, i.e. with no date. The generator and user of this time must understand a common reference point, for example the start of the scenario.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#ReligionCode">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#OrganizationCode"/>
    <rdfs:comment>Alphabetic code, up to six letters, representing a religion, obtained from JC3IEDM-3.0.2 AffiliationReligionCode</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#MessageCode">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#MessageConcept"/>
    <rdfs:comment>Enumerations used in messages.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasDISSubCategory">
    <rdfs:subPropertyOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasDISCode"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#byte"/>
    <rdfs:comment>Provides a SubCategory Code from the DIS standard IEEE 1516-2010.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#SystemMessageBody">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#MessageBody"/>
    <rdfs:comment>The body of a message that is used to send coalition-level commands, requests, and reports between systems participating in the C2SIM coalition.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasReportID">
    <rdfs:subPropertyOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasMessagingDataProperty"/>
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#UUIDBase"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasEntityTypeName">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Name of an NamedEntityType.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasEntity">
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#Entity"/>
    <rdfs:comment>A generic relation to an instance of an Entity.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/smx#HostilityStatusCode">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#Code"/>
    <rdfs:comment>Enumerations of possible hostility relationships in a military situation. Derived from JC3IEDM-v3.0.1.ObjectItemHostilityStatusCode</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#OperationalStatusCode">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#Code"/>
    <rdfs:comment>An enumeration indicating the general level of capability of an entity relative to its greatest expected capability.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#isToReceivingSystem">
    <rdfs:subPropertyOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasMessagingDataProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Unique FIPA identifer of the system to which individual message is sent.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasFileSize">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
    <rdfs:comment>File size in kilobytes (rounded to nearest integer).</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/lox#hasPlanPhaseTrigger">
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/lox#PlanPhaseTrigger"/>
    <rdfs:comment>Provides the condition that will trigger an LOX PlanPhase</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasNamedEntityType">
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#NamedEntityType"/>
    <rdfs:comment>Property to specify additional (and more specific) information about the type of an entity.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/smx#hasReinforcedReducedType">
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/smx#ReinforcedReducedType"/>
    <rdfs:comment>Indiates the current code for type of reiforcement or reduction of an ENtity.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#CountryCode">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#OrganizationCode"/>
    <rdfs:comment>A unique three-letter code for each nation on Earth, defined in ISO 3166-1 standard and also found in JC3IEDM AffiliationGeopoliticalCode.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#Location">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#PhysicalConcept"/>
    <rdfs:comment>A representation of location in space. Can be a coordinate value, a reference to an entity location, or a location relative to another location.

An optional altitude representation code indicates whether this is a fully specified point in 3 dimensions, or whether the altitude encoded in the class should be ignored or set to some other reference. If the code is not present, then the location is assumed to be a fully specified 3D point.

The location of a CollectiveEntity may represent the center of mass or headquarters location in the case of an organization.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#MapGraphic">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#PhysicalEntity"/>
    <rdfs:comment>Graphics on a map that define locations, lines, areas, actions, etc. The location of the graphic is the location in the real world represented on the map. The extent is the set of handle points or vertices that define its shape and size. This class includes task graphics, METOC graphics, and MOOTW graphics.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#TemporalConcept">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#PhysicalConcept"/>
    <rdfs:comment>Time concepts include instants in time, durations of time, and intervals between two times.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#RequestContent">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#MessageConcept"/>
    <rdfs:comment>The content of a request message in the domain. This is a parent class that has subclasses for different types of requests.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#Relationship">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#C2SIMContent"/>
    <rdfs:comment>This class describes a relationship to some entity. The type of relationship is defined by a subclass, which has a code property that specifies what the relationship is.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasTaskActionCode">
    <rdfs:subPropertyOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasActionCode"/>
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#TaskActionCode"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#MilitaryOrganization">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#CollectiveEntity"/>
    <rdfs:comment>A collective entity that is a military organization (i.e., a unit).</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasAuthorizationHeader">
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#AuthorizationHeader"/>
    <rdfs:comment>The authentication header of a C2SIM header.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/smx#hasConfidenceLevel">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:comment>Provides a confidence level associated with a class, from a range of values.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasEthnicGroupCode">
    <rdfs:subPropertyOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasOrganizationCode"/>
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#EthnicGroupCode"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/smx#hasSpecialC2HQ">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Provides a reference to aSpecial Comamnd and Control Headquarter for a military Entity.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasMessageBody">
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#MessageBody"/>
    <rdfs:comment>Reference to a Body class for a Message.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasOrganizationTypeCode">
    <rdfs:subPropertyOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasOrganizationCode"/>
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#OrganizationTypeCode"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasAltitudeAGL">
    <rdfs:subPropertyOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasAltitude"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:comment>Property of geospatial data values that represent distance vertically above ground level in meters.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#isFromSendingSystem">
    <rdfs:subPropertyOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasMessagingDataProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Unique FIPA identifer of the system from which individual message is sent.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#C2SIMContent">
    <rdfs:comment>Class of all concepts for the content of messages in the core C2SIM data model.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasCurrentState">
    <rdfs:subPropertyOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasEntityState"/>
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#EntityState"/>
    <rdfs:comment>Provides value for the current state of an Entity.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasIsoDateTime">
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#IsoDateTimeBase"/>
    <rdfs:comment>Instances of the class include identifying "When" information in ISO Date Time format.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#TimeReferenceCode">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#Code"/>
    <rdfs:comment>Indicates whether a relative time is referenced to the start or the end of an interval time.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#EthnicGroupCode">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#OrganizationCode"/>
    <rdfs:comment>Alphabetic code up to six letters, describing an ethnic group, obtained from JC3IEDM AffiliationEthnicGroupCode-3.0.2</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasEntityHealthStatus">
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#EntityHealthStatus"/>
    <rdfs:comment>Provide a HealthStatus value for an Entity.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#Platform">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#ActorEntity"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N6fec69381fcc40188bf1c961a9ae123c">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasCurrentState"/>
        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
        <owl:onClass rdf:resource="http://www.sisostds.org/ontologies/C2SIM#PhysicalState"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N067a8cd37b98485abd67c5312e8b0856">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasMarking"/>
        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>An Entity that consists of an identifiable type physical equipment and/or software.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#CommunicativeActTypeCode">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#MessageCode"/>
    <rdfs:comment>Enumeration of different types of communications.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/lox#hasTaskFunctionalRelation">
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/lox#TaskFunctionalRelation"/>
    <rdfs:comment>Provides a JC3IEDM FunctionalRelation code for an LOX Task.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/lox#hasTaskFunctionalAssociationCode">
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/lox#TaskFunctionalAssociationCode"/>
    <rdfs:comment>Provides a JC3IEDM ActionFunctionalAssociateCode forn LOX Task.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasRequestingEntity">
    <rdfs:subPropertyOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasActorReference"/>
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#UUIDBase"/>
    <rdfs:comment>The reference is to an instance of RequestingEntity.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasSuperior">
    <rdfs:subPropertyOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasActorReference"/>
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#UUIDBase"/>
    <rdfs:comment>The reference is to an instance of Entity that is superior (that is, has authority to provide direction) for purposes of the class.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/lox#RuleOfEngagement">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#C2SIMContent"/>
    <rdfs:comment>A rule that describes the conditions under which weapons can be used to engage other forces. This class is a collection class; different types of ROEs will be subclasses of this class.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/smx#APP6CSymbol">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#C2SIMContent"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N48442541922049c781ae540675795bb5">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/smx#hasAPP6C-SIDC"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>Tactical graphic symbol as specified by NATO APP-6-C.
Used to define the type of an Entity for its representation and depiction on C2 displays.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasAuthorizationType">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>The authentication scheme (or type), such as Basic, Bearer, Digest, etc. It indicates the method used for encoding or handling the credentials.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasLocation">
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#Location"/>
    <rdfs:comment>Provides a geospatial Location for an Object.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasEventReference">
    <rdfs:subPropertyOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasActionReference"/>
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#UUIDBase"/>
    <rdfs:comment>The reference is to another Action class identifying an Event.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/smx#hasEchelonCode">
    <rdfs:subPropertyOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasCode"/>
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/smx#EchelonCode"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/lox#PlanPhaseCompletionCondition">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#Code"/>
    <rdfs:comment>A code defining the condition to be used to test the tasks of a plan phase to determine whether the phase is considered to be complete.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#OrganizationCode">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#Code"/>
    <rdfs:comment>These provide enumerations of alphabetic text codes identifying characteristics of organizations.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasSISOEntityType">
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#SISOEntityType"/>
    <rdfs:comment>Provide a value for the SISO Entity Type of a C2SIM Entity or a C2SIM Resource.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasTask">
    <rdfs:subPropertyOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasAction"/>
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#Task"/>
    <rdfs:comment>Reference to a Task object.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#MessageConcept">
    <rdfs:comment>This parent class collects together classes that define the basic structure of messages used in C2SIM.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/smx#hasObservation">
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/smx#Observation"/>
    <rdfs:comment>Indicates an Observation value associated with a class.</rdfs:comment>
  </owl:ObjectProperty>
</rdf:RDF>
