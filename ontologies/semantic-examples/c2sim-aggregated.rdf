        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasDISDomain"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#byte"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N176cb591694e433fb8fdddf5d7bf7b03">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasDISExtra"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#byte"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
