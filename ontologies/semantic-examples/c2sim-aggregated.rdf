    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/smx#ForceSideRelation"/>
    <rdfs:comment>Indicates the ForceSideRelation code for an Entity.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasDISKind">
