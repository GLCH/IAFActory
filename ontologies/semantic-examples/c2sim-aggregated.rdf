  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasEventCode">
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasActionCode">
