        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
        <owl:onClass rdf:resource="http://www.sisostds.org/ontologies/lox#PlanPhase"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Ne1ec2066e59a44d2bf0552d7c5231806">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/lox#hasPlanPhaseReference"/>
        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.sisostds.org/ontologies/C2SIM#UUIDBase"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N1a16100e4bc54d3bb2f8b633f8d95a92">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/lox#isToBeExecutedNow"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>This message orders the recipient unit to begin execution of the indicated plan.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/lox#PriorPhaseCompletionTrigger">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/lox#PlanPhaseTrigger"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N9ab684165eff458383b259e81d2f7322">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/lox#hasTriggerPhase"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.sisostds.org/ontologies/C2SIM#UUIDBase"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>A plan phase trigger that is based on the completion of another plan phase (typically, the phase immediately before this one in a plan).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#PlaybackStatusReport">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#SystemMessageBody"/>
