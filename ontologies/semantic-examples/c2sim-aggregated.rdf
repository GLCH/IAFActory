        <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#UUIDBase"/>
        <rdfs:comment>These references should be to objects of class Actor, or subclasses.</rdfs:comment>
      </owl:DatatypeProperty>
    </rdfs:subPropertyOf>
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#UUIDBase"/>
    <rdfs:comment>The reference is to an instance of Entity that is subordinate for purposes of the class.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasInitializationDataFile">
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#InitializationDataFile"/>
    <rdfs:comment>Provides an identifier for a file containing initialization data.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#ReportBody">
