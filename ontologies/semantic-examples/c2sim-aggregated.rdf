        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.sisostds.org/ontologies/C2SIM#latitude"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N4835cd5865e24b009af0ed5ed93dfab1">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasLongitude"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.sisostds.org/ontologies/C2SIM#longitude"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N0be780d9a496405bb7e4dd4c0f240ff6">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasAltitudeAGL"/>
        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Ncc17253ba738442e958c73d67f3cd2b1">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasAltitudeMSL"/>
        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>A location defined by latitude, longitude, and altitude.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasWidth">
    <rdfs:subPropertyOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasDistance"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:comment>Property of geospatial data value that represents width aspect of a distance in meters.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Ontology rdf:about="http://www.sisostds.org/ontologies/C2SIM">
    <rdfs:comment>CWIX 2025 built on CWIX 2024 branch, based on version 1.0.1 SISO Standard, April 2022.</rdfs:comment>
    <owl:versionInfo>C2SIM Core Ontology version CWIX2025</owl:versionInfo>
  </owl:Ontology>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/lox#MipWeaponUseROE">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/lox#RuleOfEngagement"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N31630336d5e74d02a399bf47e00fd438">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/lox#hasWeaponROECode"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="http://www.sisostds.org/ontologies/lox#WeaponRuleOfEngagementCode"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>A RuleofEngagement that is based on a standard code describing engagement conditions.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#ShareScenario">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#SystemMessageBody"/>
    <rdfs:comment>Sent by a C2SIM controller to a marshalling server. When this C2SIM message is received, the marshalling server sends to all subscribed systems the C2SIM initialization message.</rdfs:comment>
  </owl:Class>
  <rdf:Description rdf:nodeID="Na5f5936c16c24f1da34369696bdab63e">
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
  </rdf:Description>
  <owl:Axiom rdf:nodeID="Necf873a4db5340bbb5924c286c2ef342">
    <owl:annotatedSource rdf:resource="http://www.sisostds.org/ontologies/C2SIM#ReportBody"/>
    <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
    <owl:annotatedTarget>
      <owl:Restriction rdf:nodeID="N4c0e028d23424d0984b95d340acdd739">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasReportingEntity"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.sisostds.org/ontologies/C2SIM#UUIDBase"/>
      </owl:Restriction>
    </owl:annotatedTarget>
    <rdfs:comment>This is the unique identifier of an individual of the ActorEntity class, that is making the report.</rdfs:comment>
  </owl:Axiom>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#CulturalFeature">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#PhysicalEntity"/>
    <rdfs:comment>Any man-made feature in the environment</rdfs:comment>
  </owl:Class>
  <rdf:Description rdf:nodeID="N71fc85a64d1643e1a0108b8ac442d087">
    <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
  </rdf:Description>
  <owl:AllDisjointClasses rdf:nodeID="N14489445b2084b8691eb353d53912ed9">
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="http://www.sisostds.org/ontologies/C2SIM#DateTime"/>
      <rdf:Description rdf:about="http://www.sisostds.org/ontologies/C2SIM#Duration"/>
      <rdf:Description rdf:about="http://www.sisostds.org/ontologies/C2SIM#IntervalTime"/>
    </owl:members>
  </owl:AllDisjointClasses>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#RequestPlaybackRealtimeMultiple">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#SystemMessageBody"/>
    <rdfs:comment>System command for requesting the current setting of the playbackRealtimeMultiple value indicating the multiple of simulation time to realtime currently set for recording playback in the C2SIM coalition of systems.</rdfs:comment>
  </owl:Class>
  <owl:Axiom rdf:nodeID="N91bb00ac712f4262ac0cafb3a64585a0">
    <owl:annotatedSource rdf:resource="http://www.sisostds.org/ontologies/C2SIM#EulerAngles"/>
    <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
    <owl:annotatedTarget>
      <owl:Restriction rdf:nodeID="N4703516711034932a88ca973b2a600ba">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasPsi"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.sisostds.org/ontologies/C2SIM#angle"/>
      </owl:Restriction>
    </owl:annotatedTarget>
    <rdfs:comment>Angle in radians</rdfs:comment>
  </owl:Axiom>
  <rdf:Description rdf:nodeID="N4a1ac480554a487c91b367767c0f3715">
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
  </rdf:Description>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/smx#SurfaceVessel">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#Platform"/>
    <rdfs:comment>Water surface vehicle assembled for military use</rdfs:comment>
  </owl:Class>
  <owl:Axiom rdf:nodeID="N9cb8e8e23686489cafa09f99fb94b16d">
    <owl:annotatedSource rdf:resource="http://www.sisostds.org/ontologies/C2SIM#MoveToLocation"/>
    <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
    <owl:annotatedTarget rdf:resource="http://www.sisostds.org/ontologies/C2SIM#TaskActionCode"/>
    <rdfs:comment>The destination of this Movement task is defined as follows: 
-Location property of the Task.  This is a choice of coordinate values, or an entity-defined reference (or entity-relative location); entity-defined can refer to a unit or a map graphic. This is an alternate way to specify location via a map graphic; see below.
- MagGraphicID of the Task. The destination is the Location of the map graphic.</rdfs:comment>
  </owl:Axiom>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#StartPlayback">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#SystemMessageBody"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N9fe92cea99d74eb58981cee461ea07c3">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasStartTime"/>
        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
        <owl:onClass rdf:resource="http://www.sisostds.org/ontologies/C2SIM#SimulationTime"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N916d511ff8c14e64a57125fb146cadbc">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasName"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>System command ordering the initiation of playback of recorded C2SIM messages in a C2SIM coalition of systems. The name refers to the name given to a recording that was previously created for later playback. The start time refers to the position in the recording where the playback is to begin. Playback is controlled by the C2SIM server sending out C2SIM messages that were previously recorded.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/smx#ActivityObservation">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/smx#Observation"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Ne174e7d704b9415eb5f190088c3cc225">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasActionCode"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="http://www.sisostds.org/ontologies/C2SIM#ActionCode"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>An observation of the activity of the subject.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#SetPlaybackRealtimeMultiple">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#SystemMessageBody"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N0b5e4a1bf4cd4ce59afb8cf2d4628fa8">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasPlaybackRealtimeMultiple"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.sisostds.org/ontologies/C2SIM#playbackRealtimeMultiple"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>System command for setting the playbackRealtimeMultiple value indicating the  multiple of simulation time to realtime for playback of recorded messages in the C2SIM coalition of systems.The SetPlaybackRealtimeMultiple enables a user in a C2SIM coalition to direct playback of recorded messages at a rate faster or slower than realtime. For example, a playbackRealtimeMultiple value of 2.0 directs recording playback at 2:1 simulation time to realtime (i.e., faster than realtime); a value of 0.5 directs recording playback at half realtime (i.e., slower than realtime).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#Message">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#MessageConcept"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N4ce6ebd10b354006a9f4ce683fb4ebf3">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasC2SIMHeader"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="http://www.sisostds.org/ontologies/C2SIM#C2SIMHeader"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N55106be72a5248708fab600ec6f04373">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasMessageBody"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="http://www.sisostds.org/ontologies/C2SIM#MessageBody"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>Any C2SIM message that is sent between host systems.</rdfs:comment>
  </owl:Class>
  <rdf:Description rdf:nodeID="N1763029072fb46e6a5c83693baaf35d4">
    <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
  </rdf:Description>
  <owl:Axiom rdf:nodeID="N89e455be029b445f895d216ae3a9a10c">
    <owl:annotatedSource rdf:resource="http://www.sisostds.org/ontologies/smx#Unit"/>
    <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
    <owl:annotatedTarget>
      <owl:Restriction rdf:nodeID="N1878c5a27c814c989450e0b1c00bf5ac">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/smx#hasCommandRelation"/>
        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
        <owl:onClass rdf:resource="http://www.sisostds.org/ontologies/smx#CommandRelation"/>
      </owl:Restriction>
    </owl:annotatedTarget>
    <rdfs:comment>An optional command relationship, which specifies an object (actor) of the relation and the relation type.</rdfs:comment>
  </owl:Axiom>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/smx#ResourceObservation">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/smx#Observation"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Ncae6fb76e2244737a6ee521583b9740c">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasResource"/>
        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
        <owl:onClass rdf:resource="http://www.sisostds.org/ontologies/C2SIM#Resource"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>Observations on resource availability, e.g. fuel, ammunition</rdfs:comment>
  </owl:Class>
  <owl:Axiom rdf:nodeID="Nddba93a260434c5992b9ee34ff9116e0">
    <owl:annotatedSource rdf:resource="http://www.sisostds.org/ontologies/C2SIM#SystemEntityList"/>
