      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>The status of a task, provided before, during or after a task is executed.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#AllegianceRelationship">
