      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>The body of a message that is sent between actors in the domain.
It is one subclass of MessageBody (other subclasses perform administrative functions in the C2SIM Coalition.)</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasMarking">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
