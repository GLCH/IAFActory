        <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#ActionCode"/>
      </owl:ObjectProperty>
    </rdfs:subPropertyOf>
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#EventCode"/>
  </owl:ObjectProperty>
