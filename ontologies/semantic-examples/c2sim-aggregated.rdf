  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#Overlay">
    <rdfs:subClassOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#AbstractObject"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nfd3bfd71ef564103989361384cf80e61">
        <owl:onProperty rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasEntityReference"/>
        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.sisostds.org/ontologies/C2SIM#UUIDBase"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:comment>A logical grouping of Entities (units, graphics, etc.) for purposes of conveniently referring to them.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasDelayTimeAmount">
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasTemporalConcept">
        <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#TemporalConcept"/>
        <rdfs:comment>Provides a value for a TemporalConcept associated with a Task or Activity.</rdfs:comment>
      </owl:ObjectProperty>
    </rdfs:subPropertyOf>
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#Duration"/>
    <rdfs:comment>Provides a value in ISO format for a time delay from some other referenced value</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasDuration">
    <rdfs:subPropertyOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasTemporalConcept"/>
    <rdfs:range rdf:resource="http://www.sisostds.org/ontologies/C2SIM#Duration"/>
