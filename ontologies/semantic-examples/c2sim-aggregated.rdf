  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://www.sisostds.org/ontologies/C2SIM#hasUp">
    <rdfs:subPropertyOf rdf:resource="http://www.sisostds.org/ontologies/C2SIM#hasCoordinateValue"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:comment>Value for Up coordinate is included.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://www.sisostds.org/ontologies/C2SIM#ActorEntity">
