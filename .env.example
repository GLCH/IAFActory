# Copier en .env via scripts/init-env.ps1 (genere des mots de passe aleatoires).
# Ne jamais committer .env.

POSTGRES_USER=iaf
POSTGRES_PASSWORD=
POSTGRES_DB=iafactory
POSTGRES_PORT=5432

NEO4J_PASSWORD=
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HEAP=512m

JENA_VERSION=6.2.0
FUSEKI_ADMIN_PASSWORD=
FUSEKI_PORT=3030
FUSEKI_JAVA_OPTIONS=-Xmx1g

OLLAMA_PORT=11434

# Passerelle LLM. Cles generees par scripts/init-env.ps1 ; la cle de sel ne se
# change plus une fois des cles fournisseurs stockees (doc LiteLLM).
LLM_GATEWAY_PORT=4000
LITELLM_DB_PASSWORD=
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
# Cles des fournisseurs (hybride Anthropic + Gemini + Ollama local) : a saisir
# par vous-meme, jamais generees ni committees. Ollama n'a pas de cle (local).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
